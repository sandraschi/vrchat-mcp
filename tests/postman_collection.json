  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Set dynamic timestamp for unique test data",
          "pm.globals.set(\"timestamp\", new Date().getTime());",
          "",
          "// Set random test values",
          "pm.globals.set(\"random_value\", Math.random());",
          "pm.globals.set(\"random_int\", Math.floor(Math.random() * 100));"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Common test assertions",
          "pm.test(\"Status code is not 5xx\", function () {",
          "    pm.response.to.not.be.serverError;",
          "});",
          "",
          "pm.test(\"Response time is less than 2000ms\", function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(2000);",
          "});",
          "",
          "pm.test(\"Response has proper content type\", function () {",
          "    var contentType = pm.response.headers.get('Content-Type');",
          "    if (contentType) {",
          "        pm.expect(contentType).to.include('application/json');",
          "    }",
          "});",
          "",
          "// Specific tests for different endpoints",
          "var url = pm.request.url.toString();",
          "",
          "if (url.includes('/health')) {",
          "    pm.test(\"Health endpoint returns 200\", function () {",
          "        pm.response.to.have.status(200);",
          "    });",
          "    ",
          "    pm.test(\"Health response has status field\", function () {",
          "        var jsonData = pm.response.json();",
          "        pm.expect(jsonData).to.have.property('status');",
          "    });",
          "}",
          "",
          "if (url.includes('/api/v1/')) {",
          "    pm.test(\"API endpoint returns valid JSON\", function () {",
          "        pm.response.to.be.json;",
          "    });",
          "}",
          "",
          "// Error handling tests",
          "if (url.includes('nonexistent_tool')) {",
          "    pm.test(\"Non-existent tool returns 404\", function () {",
          "        pm.response.to.have.status(404);",
          "    });",
          "}",
          "",
          "if (url.includes('set_parameter') && pm.request.body.raw.includes('invalid_number')) {",
          "    pm.test(\"Invalid parameter returns 400\", function () {",
          "        pm.response.to.have.status(400);",
          "    });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "timestamp",
      "value": "",
      "type": "any"
    },
    {
      "key": "random_value",
      "value": "",
      "type": "any"
    },
    {
      "key": "random_int",
      "value": "",
      "type": "any"
    }
  ]
