{
  "name": "vrchat-mcp",
  "version": "1.0.0",
  "description": "VRChat avatar and world control via OSC protocol - Real-time avatar parameter manipulation, world interactions, and social VR automation with Austrian precision",
  "author": "Sandra",
  "license": "MIT",
  "homepage": "https://github.com/sandraschi/vrchat-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/sandraschi/vrchat-mcp"
  },
  "main": "server/server.py",
  "mcp": {
    "version": "1.0",
    "capabilities": ["tools"],
    "prompts": {
      "system": "assets/prompts/system.md",
      "avatar_control": "assets/prompts/avatar_control.md",
      "osc_protocol": "assets/prompts/osc_protocol.md",
      "social_interactions": "assets/prompts/social_interactions.md",
      "world_automation": "assets/prompts/world_automation.md",
      "performance_tips": "assets/prompts/performance_tips.md",
      "troubleshooting": "assets/prompts/troubleshooting.md"
    }
  },
  "runtime": {
    "python": ">=3.8"
  },
  "dependencies": {
    "fastmcp": ">=2.12.0",
    "python-osc": ">=1.8.0",
    "pydantic": ">=2.0.0",
    "httpx": ">=0.27.0"
  },
  "features": [
    "Real-time OSC avatar parameter control",
    "Avatar expression and gesture automation",
    "World interaction via OSC",
    "Social VR automation",
    "Avatar state monitoring",
    "Parameter synchronization",
    "Plugin system for extensibility",
    "Dual interface (stdio MCP + HTTP FastAPI)",
    "Comprehensive logging and monitoring",
    "Claude Desktop integration",
    "Austrian engineering quality"
  ],
  "vrchat_features": {
    "avatar_parameters": "Control avatar blend shapes, toggles, and animations",
    "expressions": "Trigger facial expressions and gestures",
    "world_triggers": "Activate world objects and events via OSC",
    "tracking": "Monitor avatar position and state",
    "input_simulation": "Simulate VRChat input actions",
    "chatbox": "Send messages to VRChat chatbox"
  },
  "requirements": {
    "software": ["VRChat (Steam or Oculus version)", "OSC enabled in VRChat settings"],
    "network": ["UDP port 9000 (VRChat OSC default)"],
    "vr": ["Optional: VR headset for full experience"]
  },
  "osc_protocol": {
    "receive_port": 9001,
    "send_port": 9000,
    "address_space": "/avatar/parameters/*, /avatar/change, /input/*, /chatbox/*"
  },
  "keywords": [
    "vrchat",
    "osc",
    "avatar",
    "virtual-reality",
    "social-vr",
    "automation",
    "metaverse",
    "real-time",
    "fastmcp",
    "claude-desktop",
    "austria"
  ]
}

