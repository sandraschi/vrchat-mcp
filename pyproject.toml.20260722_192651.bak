[build-system]
requires = ["setuptools>=42", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "vrchat-mcp"
version = "14.1.0"
description = "VRChat MCP for controlling avatars and assets with FastMCP 3.2.0 (SOTA Industrialized)"
authors = [
    {name = "Sandra Schi"}
]
license = {text = "MIT"}
requires-python = ">=3.12"
dependencies = [
    "aiohttp>=3.9.0",
    "fastmcp>=3.4.4,<4",
    "numpy>=1.24.0",
    "python-osc>=1.8.1",
    "pydantic>=2.0.0",
    "fastapi>=0.100.0",
    "uvicorn>=0.23.0",
    "python-dotenv>=1.0.0",
    "loguru>=0.7.0",
    "httpx>=0.25.0",
    "ruff>=0.15.2",
    "vrchatapi>=1.0.0",
    "websockets>=12.0",
    "cachetools>=5.3.0",
    "prefab-ui>=0.14.0",
]

[project.optional-dependencies]
dev = [
    "pytest>=7.0.0",
    "pytest-asyncio>=0.21.0",
    "pytest-cov>=4.0.0",
    "black>=23.0.0",
    "isort>=5.12.0",
    "mypy>=1.0.0",
    "types-python-dateutil>=2.8.0",
    "requests>=2.31.0",
]

[tool.black]
line-length = 88
target-version = ['py38']
include = '\.pyi?$'

[project.scripts]
vrchat-mcp = "vrchat_mcp.cli:main"

[tool.ruff]
line-length = 120
target-version = "py312"

[tool.ruff.lint]
select = ["E", "F", "W", "I", "B", "S", "UP", "RUF"]
ignore = ["S101", "B008"]

[tool.ruff.format]
quote-style = "double"
indent-style = "space"
